# Copie este arquivo para ".env" (cp .env.example .env) e preencha com os dados do SEU servidor Azure.
# O arquivo .env nunca vai para o Git (tem senha!).
# NEON: no link do Neon  postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require  copie assim:
#   DB_HOST=HOST (ep-nome-123456.sa-east-1.aws.neon.tech)  DB_NAME=BANCO (neondb)  DB_USER=USUARIO  DB_PASSWORD=SENHA  DB_SSLMODE=require
DB_HOST=SEU-SERVIDOR.postgres.database.azure.com
DB_PORT=5432
DB_NAME=ctiinsights
DB_USER=ctiadmin
DB_PASSWORD=sua-senha
DB_SSLMODE=require

# Chave combinada com o backend (ETL_KEY no backend/.env). Vazio = sem chave (só para estudar no seu computador).
ETL_API_KEY=
