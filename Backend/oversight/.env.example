# Local development only. Replace every placeholder before starting the API.
# Neon connection details: JDBC URL, database role and role password.
DB_URL=jdbc:postgresql://SEU-HOST-NEON/neondb?sslmode=require
DB_USER=SEU-USUARIO-NEON
DB_PASSWORD=SUBSTITUA-PELA-SENHA-DO-NEON

# Generate random unique values; JWT_SECRET must contain at least 32 bytes.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480
CORS_ORIGINS=http://localhost:5173

# The first configured administrator is created on startup.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=

# Local Python URL; in Railway use the private service URL ending in /etl.
ETL_URL=http://localhost:8000/etl
ETL_KEY=
